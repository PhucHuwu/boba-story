# All values are secrets: set them in Vercel (project boba-story-admin), never commit real values.
ADMIN_USERNAME=
# Output of: npm run hash-password  (reads the password from stdin)
ADMIN_PASSWORD_HASH=
# Random 32+ byte string, e.g. openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Same value as ADMIN_API_KEY on the game project
ADMIN_API_KEY=
GAME_API_URL=https://boba-story.vercel.app
