# All optional. Copy to .env.local and fill in.

# OpenAI-compatible proxy: AI dialogue (/api/dialogue) and `npm run gen:assets`
AI_PROXY_BASE_URL=https://proxy.phuchuwu.io.vn/v1
AI_PROXY_API_KEY=
AI_CHAT_MODEL=gemini-3-flash
AI_IMAGE_MODEL=gemini-3.1-flash-image

# Upstash Redis (cloud save, dialogue cache, rate limit) — added automatically by the Vercel Marketplace integration
KV_REST_API_URL=
KV_REST_API_TOKEN=
